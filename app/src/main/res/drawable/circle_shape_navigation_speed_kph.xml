<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Warna isi lingkaran -->
    <solid android:color="@color/md_grey_800" />

    <!-- Ukuran lingkaran (lebar dan tinggi harus sama agar jadi lingkaran sempurna) -->
    <size
        android:width="100dp"
        android:height="100dp" />

    <!-- (Opsional) Garis tepi / Stroke -->
    <stroke
        android:width="2dp"
        android:color="@color/md_grey_500" />

</shape>
